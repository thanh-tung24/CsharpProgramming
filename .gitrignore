## ==========================================
## Visual Studio & .NET Standard GitIgnore
## ==========================================

# Thư mục cấu hình cá nhân của Visual Studio
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Thư mục build output (file chạy, dll sinh ra)
[Bb]in/
[Oo]bj/
[Aa]rm/
[Aa]rm64/
[Xx]64/
[Xx]86/

# Các file build tạm
*.exe
*.dll
*.pdb
*.ilk
*.aps
*.intermediate.manifest

# File tạm và log của Visual Studio
*.log
*.tlog
*.vspscc
*.vssscc
*.cache
*.opendb
*.db
*.TMP
*.tmp

# Báo cáo kết quả kiểm thử (Test Results)
[Tt]est[Rr]esult*/
[Bb]uild[Ll]og.*

# Thư mục gói NuGet
packages/
*.nuget.props
*.nuget.targets

# Backup & Auto-recovery files
_UpgradeReport_Files/
Backup*/
UpgradeLog*.XML
UpgradeLog*.htm